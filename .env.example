# ============================================
# AI Vision Chat Assistant - 全局环境变量
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ---- DeepSeek API ----
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 服务端口 ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
