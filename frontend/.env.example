# ============================================
# AI Vision Chat Assistant - 前端环境变量
# ============================================
# Vite 环境变量必须以 VITE_ 开头才会暴露给前端代码
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# 后端 API 基础地址（Vite 代理模式下使用相对路径）
VITE_API_BASE_URL=/api

# WebSocket 服务地址
VITE_WS_URL=/ws
