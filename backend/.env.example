# ============================================
# AI Vision Chat Assistant - 后端环境变量
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# .env 已在 .gitignore 中排除，不会上传到 GitHub
# ============================================

# ---- 服务器配置 ----
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---- 跨域配置 ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# ---- DeepSeek API Key (所有 AI 能力共用) ----
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- OpenAI API Key (Whisper STT / OpenAI TTS 备选) ----
# DeepSeek 不提供 Whisper/TTS，如需 STT 请填入 OpenAI Key
# 不填则回退到 DEEPSEEK_API_KEY，STT 不可用但其他功能正常
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 科大讯飞 STT (主力语音识别) ----
# 从 https://console.xfyun.cn/ 创建应用获取
XFYUN_APPID=your_xfyun_appid
XFYUN_API_KEY=your_xfyun_api_key
XFYUN_API_SECRET=your_xfyun_api_secret

# 语音识别引擎: xfyun (讯飞) / whisper (OpenAI)
STT_ENGINE=xfyun
STT_LANGUAGE=zh

# ---- TTS 语音合成 ----
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_SPEED=1.0

# ---- 音频参数 ----
AUDIO_SAMPLE_RATE=16000

# ---- 成本优化（比赛场景） ----
OPT_COST_SAVING_MODE=true

# ---- 日志级别 ----
LOG_LEVEL=INFO
